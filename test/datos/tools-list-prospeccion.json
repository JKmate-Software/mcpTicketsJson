          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "Fecha ancla (AAAA-MM-DD). Si se omite, hoy."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "intervalos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intervalo": {
                "type": "string"
              },
              "fechaDesde": {
                "description": "AAAA-MM-DD",
                "type": [
                  "string",
                  "null"
                ]
              },
              "fechaHasta": {
                "description": "AAAA-MM-DD",
                "type": [
                  "string",
                  "null"
                ]
              },
              "asignados": {
                "type": "integer",
                "minimum": -9007199254740991
              },
              "nuevos": {
                "type": "integer",
                "minimum": -9007199254740991
              },
              "agendados": {
                "type": "integer",
                "minimum": -9007199254740991
              },
              "gestionados": {
                "type": "integer",
                "minimum": -9007199254740991
              }
            },
            "required": [
              "intervalo",
              "fechaDesde",
              "fechaHasta",
              "asignados",
              "nuevos",
              "agendados",
              "gestionados"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "codigo": {
              "enum": [
                "PARAMETRO_INVALIDO",
                "TICKET_NO_ENCONTRADO",
                "NO_AUTORIZADO",
                "BASE_NO_DISPONIBLE",
                "OPERACION_RECHAZADA",
                "ERROR_INTERNO"
