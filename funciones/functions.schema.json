{
  "title": "Archivo de funciones de un MCP",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "servidor": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "description": "serverInfo.name del handshake."
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "claimRequerida": {
          "type": "string",
          "enum": [
            "COD_USUARIO",
            "COD_VENDEDOR",
            "COD_DESARROLLADOR",
            "COD_PROVEEDOR",
            "COD_CLIENTE",
            "COD_EMPRESA",
            "SECUENCIAL_EMPRESA"
          ],
          "description": "Clave de identidad que necesitan las tools (token http o MCP_COD_* en stdio)."
        },
        "instrucciones": {
          "description": "Archivo .md con las instrucciones, relativo a este archivo.",
          "type": "string",
          "minLength": 1
        },
        "instruccionesEnHandshake": {
          "description": "true = enviar las instrucciones también en el handshake.",
          "type": "boolean"
        },
        "completarSesion": {
          "description": "Archivo src/catalogos/<mcp>/comunes/<nombre>.ts (o compartidas/comunes/) que completa la sesión stdio desde la base.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "nombre",
        "claimRequerida"
      ],
      "additionalProperties": false
    },
    "tools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "const": "procedure"
              },
              "procedure": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "nombre": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                "description": "Nombre de la tool (único en el archivo)."
              },
              "titulo": {
                "description": "Nombre legible (ícono + acción + objeto). Sin titulo se genera desde el nombre.",
                "type": "string",
                "minLength": 1
              },
              "descripcion": {
                "type": "string",
                "minLength": 1,
                "description": "Lo que ve el agente para decidir cuándo usar la tool."
              },
              "parametros": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nombre": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_$]*$",
                      "description": "Nombre real del parámetro en el procedure o el método (no cambia con alias)."
                    },
                    "alias": {
                      "description": "Nombre con el que lo ve y lo manda el agente.",
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "tipo": {
                      "description": "Tipo de dato: entero, decimal, texto, booleano, fecha (AAAA-MM-DD), fechaHora (ISO 8601) o json (objeto o array, llega como texto).",
                      "type": "string",
                      "enum": [
                        "entero",
                        "decimal",
                        "texto",
                        "booleano",
                        "fecha",
                        "fechaHora",
                        "json"
                      ]
                    },
                    "descripcion": {
                      "description": "Lo que ve el agente en el inputSchema.",
                      "type": "string",
                      "minLength": 1
                    },
                    "requerido": {
                      "description": "Obligatorio para el agente (default false). En un campo de sesión, true = modo forzado (oculto).",
                      "type": "boolean"
                    },
                    "default": {
                      "description": "Valor si el agente no lo manda (visible y pisable).",
                      "$ref": "#/$defs/__schema0"
                    },
                    "valorFijo": {
                      "description": "Valor constante: el parámetro no se publica y siempre va con este valor.",
                      "$ref": "#/$defs/__schema1"
                    },
                    "sanitizar": {
                      "description": "false = no quitar HTML/JavaScript de este parámetro (default true).",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "nombre",
                    "tipo"
                  ],
                  "additionalProperties": false
                }
              },
              "campoUsuario": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoVendedor": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoDesarrollador": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoProveedor": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoCliente": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoEmpresa": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "campoSecuencialEmpresa": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
              },
              "salida": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "columna": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_$]*$",
                          "description": "Columna que devuelve la consulta."
                        },
                        "nombre": {
                          "description": "Campo en la respuesta (default: la columna en camelCase).",
                          "type": "string",
                          "pattern": "^[a-z][A-Za-z0-9]*$"
                        },
                        "tipo": {
                          "description": "Conversión del valor (booleano convierte 0/1 en true/false).",
                          "type": "string",
                          "enum": [
                            "entero",
                            "decimal",
                            "texto",
                            "booleano",
                            "fecha",
                            "fechaHora"
                          ]
                        }
                      },
                      "required": [
                        "columna"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "maxFilas": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "busqueda": {
                "type": "object",
                "properties": {
                  "campos": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Columnas (o campos de salida, en listar_catalogo) contra las que se compara el texto."
                  },
                  "columnas": {
                    "description": "Columnas que vuelven al agente (prioridad sobre salida).",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_$]*$"
                    }
                  },
                  "maxResultados": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "umbral": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "maxSinBusqueda": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheMinutos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheAlcance": {
                    "description": "global SOLO si el procedure no lee RDB$GET_CONTEXT.",
                    "type": "string",
                    "enum": [
                      "usuario",
                      "global"
                    ]
                  }
                },
                "required": [
                  "campos"
                ],
                "additionalProperties": false
              },
              "escritura": {
                "type": "boolean"
              },
              "destructiva": {
                "type": "boolean"
              },
              "rechazo": {
                "type": "object",
                "properties": {
