                "additionalProperties": false
              },
              "conexionExclusiva": {
                "description": "Conexión propia fuera del pool (procedures que escriben USER_SESSION).",
                "type": "boolean"
              },
              "grupo": {
                "description": "Tool agrupadora (como listar_catalogo) de la que es variante: no se publica suelta.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
              },
