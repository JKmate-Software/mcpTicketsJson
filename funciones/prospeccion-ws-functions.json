{
  "$schema": "./functions.schema.json",
  "servidor": {
    "nombre": "mcp-prospeccion-ws-json",
    "claimRequerida": "COD_VENDEDOR"
  },
  "tools": [
    {
      "tipo": "webservice",
      "nombre": "resumen_prospeccion",
      "titulo": "📊 Consultando el resumen",
      "metodo": "PROC_MCP_RESUMEN_PROSPECCION",
      "descripcion": "Resumen de la cartera del vendedor de la sesión: una fila por intervalo (Día, Semana, Mes) con asignados, nuevos, agendados y gestionados. Una sola llamada.",
      "campoUsuario": "COD_USUARIO_IN",
      "campoVendedor": "COD_VENDEDOR_IN",
      "parametros": [
        {
          "nombre": "COD_VENDEDOR_IN",
          "tipo": "entero",
          "requerido": true
        },
        {
          "nombre": "FECHA_REFERENCIA_IN",
          "tipo": "texto",
          "descripcion": "Fecha ancla (ISO 8601). Si se omite, hoy."
        }
      ]
    },
    {
      "tipo": "webservice",
      "nombre": "totales_resultado_prospeccion",
      "titulo": "📈 Contando gestiones por resultado",
      "metodo": "ws_crm_totales_x_resultado_reclamo",
      "descripcion": "Cantidad de gestiones del vendedor de la sesión agrupadas por resultado, en un intervalo relativo a una fecha.",
      "campoUsuario": "FILTRO_USUARIO_IN",
      "campoVendedor": "FILTRO_COD_VENDEDOR_IN",
      "parametros": [
        {
          "nombre": "FILTRO_COD_VENDEDOR_IN",
          "tipo": "entero",
          "requerido": true
        },
        {
          "nombre": "FECHA_REFERENCIA_IN",
          "tipo": "texto",
          "descripcion": "Fecha ancla (ISO 8601). Si se omite, hoy."
        },
        {
          "nombre": "INTERVALO_IN",
          "tipo": "texto",
          "descripcion": "Exactamente 'Día', 'Sem', 'Mes' o 'Año' (con tilde y mayúscula inicial); otro valor no devuelve nada.",
          "requerido": true
        }
      ]
    },
    {
      "tipo": "webservice",
      "nombre": "buscar_prospectos_vendedor",
      "titulo": "🔎 Buscando prospectos",
      "metodo": "PROC_MCP_BUSCAR_PROSPECTOS",
      "descripcion": "Listado de prospectos/gestiones del vendedor de la sesión (una fila por gestión, la más reciente primero, hasta MAX_FILAS_IN), con filtros combinables. Los filtros que no se usan se omiten.",
      "campoVendedor": "COD_VENDEDOR_IN",
      "parametros": [
        {
          "nombre": "COD_VENDEDOR_IN",
          "tipo": "entero",
          "requerido": true
        },
        {
          "nombre": "COD_CAMPANIA_IN",
          "tipo": "entero",
          "descripcion": "Campaña (listar_catalogo catalogo='campanias')."
        },
        {
          "nombre": "FECHA_AGENDA_IN",
          "tipo": "texto",
          "descripcion": "Fecha (ISO 8601). Solo aplica con FILTRO_FECHA_IN 1 o 2."
        },
        {
          "nombre": "FILTRO_FECHA_IN",
          "tipo": "entero",
          "descripcion": "Filtro de fecha: 0 = ninguno, 1 = por fecha de cita, 2 = por fecha de gestión.",
          "default": 0
        },
        {
          "nombre": "CLIENTE_IN",
          "tipo": "texto",
          "descripcion": "Parte del nombre del cliente."
        },
        {
          "nombre": "COD_BARRIO_IN",
          "tipo": "entero",
          "descripcion": "Barrio (listar_catalogo catalogo='barrios')."
        },
        {
          "nombre": "COD_ACCION_IN",
          "tipo": "entero",
          "descripcion": "Acción de la última gestión (listar_catalogo catalogo='acciones')."
        },
        {
          "nombre": "ARCHIVADO_IN",
          "tipo": "booleano",
          "descripcion": "true = solo archivados; false = solo no archivados.",
          "default": false
        },
        {
          "nombre": "MAX_FILAS_IN",
          "tipo": "entero",
          "descripcion": "Máximo de filas (default 50). Si vuelven 50, avisar que hay más y sugerir un filtro.",
          "default": 50
        }
      ],
      "salida": [
        "COD_PROSPECTACION_MOVIL",
        "COD_PROSPECTO",
        "COD_CLIENTE",
        "CLIENTE",
        "TELEFONOS",
        "DOMICILIO",
        "COD_GRUPO_PROSPECTO",
        "COD_RECLAMO",
        "FECHA_HORA_GESTION",
        "ACCION",
        "COD_RESULTADO_RECLAMO",
        "RESULTADO_GESTION",
        "ULTIMO_MENSAJE",
        "FECHA_HORA_CITA",
        "CANAL",
        "CAMPANIA",
        "BARRIO",
        "ARCHIVADO"
      ]
    },
    {
      "tipo": "webservice",
      "nombre": "agendas_prospectos_vendedor",
      "titulo": "📅 Consultando la agenda",
      "metodo": "getAgendasProspectos",
      "descripcion": "Citas con prospectos del vendedor de la sesión entre dos fechas (calendario).",
      "campoVendedor": "COD_VENDEDOR_IN",
      "parametros": [
        {
          "nombre": "COD_VENDEDOR_IN",
          "tipo": "entero",
          "requerido": true
        },
        {
          "nombre": "FECHA_AGENDA_DESDE",
          "tipo": "texto",
          "descripcion": "Inicio del rango (ISO 8601).",
          "requerido": true
        },
        {
          "nombre": "FECHA_AGENDA_HASTA",
          "tipo": "texto",
          "descripcion": "Fin del rango (ISO 8601).",
          "requerido": true
        }
      ],
      "salida": [
        "FECHA_HORA_CITA",
        "FECHA_HORA_FIN",
        "COD_CLIENTE",
        "COD_PROSPECTO",
        "CLIENTE",
        "TELEFONO_MOVIL",
        "TITULO"
      ]
    },
    {
      "tipo": "webservice",
      "nombre": "historial_mensajes_prospecto",
      "titulo": "🗂️ Leyendo el historial",
      "metodo": "ws_crm_mostrar_msj_x_cliente",
      "descripcion": "Historial de gestiones de un prospecto (solo lectura). Necesita el cliente Y el prospecto (de buscar_prospectos_vendedor): sin el prospecto sale siempre vacío.",
      "parametros": [
        {
          "nombre": "COD_CLIENTE_ING",
          "tipo": "entero",
          "descripcion": "COD_CLIENTE del prospecto.",
          "requerido": true
        },
        {
          "nombre": "COD_PROSPECTO_ING",
          "tipo": "entero",
          "descripcion": "COD_PROSPECTO.",
          "requerido": true
        }
      ],
      "salida": [
        "FECHA_HORA",
        "FECHA_HORA_AGENDA",
        "CATEGORIA_MENSAJE",
        "RESULTADO_TRAMITE",
        "ESTADO_TRAMITE",
        "MENSAJE",
        "ENTIDAD_RELACIONADA",
        "USUARIO",
        "NRO_TRAMITE"
      ]
    },
    {
      "tipo": "webservice",
      "nombre": "registrar_gestion_prospecto",
      "titulo": "📝 Registrando la gestión",
      "metodo": "setProspeccionMovilB_2",
      "descripcion": "Registra una gestión (contacto, acción, resultado, próxima cita) sobre un prospecto YA EXISTENTE del vendedor de la sesión. Para un prospecto nuevo usar registrar_prospecto. Todos los códigos salen de listar_catalogo.",
      "campoUsuario": "COD_USUARIO",
      "campoVendedor": "COD_VENDEDOR",
      "parametros": [
        {
          "nombre": "COD_VENDEDOR",
          "tipo": "entero",
          "requerido": true
        },
        {
          "nombre": "COD_CLIENTE_FIREBIRD",
          "tipo": "entero",
          "descripcion": "COD_CLIENTE del prospecto (de buscar_prospectos_vendedor). Si se omite, la gestión queda en un cliente genérico.",
          "requerido": true
        },
        {
          "nombre": "COD_PROSPECTO",
          "tipo": "entero",
          "descripcion": "Prospecto existente que se gestiona.",
          "requerido": true
