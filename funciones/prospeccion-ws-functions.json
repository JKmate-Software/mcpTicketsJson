        {
          "nombre": "COD_GRUPO_PROSPECTO",
          "tipo": "entero",
          "descripcion": "catalogo='grupos'.",
          "requerido": true
        },
        {
          "nombre": "COD_COMERCIALIZADORA",
          "tipo": "entero",
          "descripcion": "Canal de venta: COD_ENTIDAD de catalogo='canales'. Sin canal la gestión no se ve bien en el listado.",
          "requerido": true
        },
        {
          "nombre": "COD_CATEGORIA_MENSAJE",
          "tipo": "entero",
          "descripcion": "Acción: catalogo='categorias'.",
          "requerido": true
        },
        {
          "nombre": "COD_RESULTADO_RECLAMO",
          "tipo": "entero",
          "descripcion": "Resultado: catalogo='resultados' con codPadre = la acción elegida.",
          "requerido": true
        },
        {
          "nombre": "FECHA_HORA_AGENDA",
          "tipo": "texto",
          "descripcion": "Próxima cita (ISO 8601). Obligatoria si el resultado tiene EXIGE_AGENDAMIENTO=1."
        },
        {
          "nombre": "MENSAJE",
          "tipo": "texto",
          "descripcion": "Texto de la gestión."
        },
        {
          "nombre": "FECHA_HORA",
          "tipo": "texto",
          "descripcion": "Fecha/hora de la gestión (ISO 8601). Si se omite, ahora."
        },
        {
          "nombre": "COD_RECLAMO",
          "tipo": "entero",
          "descripcion": "COD_RECLAMO del prospecto, si lo tiene (de buscar_prospectos_vendedor)."
        },
        {
          "nombre": "COD_BARRIO",
          "tipo": "entero",
          "descripcion": "catalogo='barrios'."
        },
        {
          "nombre": "COD_LOCALIDAD",
          "tipo": "entero",
          "descripcion": "catalogo='localidades'."
        },
        {
          "nombre": "COD_PROVINCIA",
          "tipo": "entero",
          "descripcion": "COD_PROVINCIA de la localidad elegida."
        },
        {
          "nombre": "FECHA_CIERRE_POSIBLE",
          "tipo": "texto",
          "descripcion": "Fecha estimada de cierre (ISO 8601)."
        },
        {
          "nombre": "TIPO_PLAN_DISPONIBLE",
          "tipo": "texto",
          "descripcion": "Tipo de plan de interés."
        },
        {
          "nombre": "COD_PLAN_DISPONIBLE",
          "tipo": "entero",
          "descripcion": "Plan de interés."
        },
        {
          "nombre": "FORECAST",
          "tipo": "entero",
          "descripcion": "Proyección de venta."
        },
        {
          "nombre": "MONTO_COTIZACION",
          "tipo": "decimal",
          "descripcion": "Monto cotizado."
        },
        {
          "nombre": "CANT_EMPLEADOS",
          "tipo": "entero",
          "descripcion": "Empleados (prospectos corporativos)."
        }
      ],
      "escritura": true
    },
