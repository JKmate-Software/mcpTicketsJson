# Solo para correr el servidor o los tests desde la terminal.
# Claude Desktop no lee este archivo: las variables van en claude_desktop_config.json (ver README).

# Qué MCP publica este proceso: el nombre de un archivo funciones/<nombre>-functions.json (tickets, prospeccion...)
MCP_CATALOGO=tickets
# Ruta de un archivo de funciones (tiene prioridad sobre MCP_CATALOGO)
MCP_FUNCIONES_ARCHIVO=
# Segundos que se reusa la definición de un método de METODOS_WEBSERVICES (0 = leerla en cada llamada)
MCP_WEBSERVICE_CACHE_SEGUNDOS=60
# Transporte: stdio (default, proceso local) o http (servicio con inicio de sesión OAuth)
MCP_TRANSPORTE=stdio
# Solo stdio + tickets: COD_USUARIO de JKMate de quien usa el servidor (identidad de todas las invocaciones)
MCP_COD_USUARIO=15169
# Solo stdio + prospeccion: COD_VENDEDOR de quien usa el servidor
MCP_COD_VENDEDOR=
# Solo stdio, resto de la identidad (obligatoria la que el catálogo declare como claimRequerida)
MCP_COD_DESARROLLADOR=
MCP_COD_PROVEEDOR=
MCP_COD_CLIENTE=
MCP_COD_EMPRESA=
MCP_SECUENCIAL_EMPRESA=
# Tope de filas en memoria de la caché de catálogos con búsqueda (prospección)
MCP_BUSQUEDA_CACHE_MAX_FILAS=200000
# Zona en la que Firebird guarda los TIMESTAMP (no tienen zona propia)
ZONA_HORARIA_BASE=America/Argentina/Buenos_Aires

# Logging (Pino a stderr y, si hay SEQ_URL, también a Seq)
LOG_LEVEL=info
SEQ_URL=
SEQ_API_KEY=

# Base de tickets (Firebird 3)
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=E:\Bases\CREAR_JK3_20261016.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=
FIREBIRD_POOL_MAX=5

# Solo http: inicio de sesión OAuth (mismas variables que el MCP de tickets v1)
MCP_HTTP_PUERTO=3000
# URL pública si queda detrás de un proxy (ej. https://mcp.ejemplo.com/tickets-v2)
MCP_URL_PUBLICA=
# Secreto HS256 de los tokens (obligatorio en http). Nunca lo subas al repo.
MCP_JWT_SIGNING_KEY=
MCP_JWT_EXPIRACION_SOBRE_DIAS=15
# Tipo de login: alias/clave, desarrollador/clave, tlfvendedor... (lo resuelve PROC_GET_AUTH_CREDENCIAL)
MCP_AUTH_TIPO=alias/clave
MCP_AUTH_TITULO_AUTORIZACION=Autorizar acceso al MCP
MCP_AUTH_APIKEY_REQUERIDO=true
MCP_AUTH_APIKEY_TITULO=Usuario
MCP_AUTH_APISECRET_REQUERIDO=true
MCP_AUTH_APISECRET_TITULO=Clave
# Base de OAuth, solo si es otra distinta de la de tickets (cada valor vacío cae en su FIREBIRD_*)
MCP_OAUTH_DB_HOST=
MCP_OAUTH_DB_PORT=
MCP_OAUTH_DB_PATH=
MCP_OAUTH_DB_USER=
MCP_OAUTH_DB_PASSWORD=

# Test de integración del inicio de sesión (npm run test:integracion). Usar una base de pruebas,
# nunca la de producción. APISECRET vacío = login sin clave (ej. tlfvendedor).
OAUTH_PRUEBA_TIPO=alias/clave
OAUTH_PRUEBA_APIKEY=
OAUTH_PRUEBA_APISECRET=

# Medición v1 contra v2 (npm run medir). La v2 se lanza sola por stdio con las variables de arriba.
MEDICION_URL_V1=
MEDICION_TOKEN_V1=

# Medición con agente real (npm run medir:agente). Usa la API de Anthropic y consume tokens.
# Alternativa a la API key: un perfil de `ant auth login`.
# ANTHROPIC_API_KEY=

# Tests de integración de prospección (npm run test:integracion), contra la base de pruebas.
# APISECRET vacío = login sin clave (tlfvendedor). _2 = un segundo vendedor (opcional).
PROSPECCION_PRUEBA_TIPO=tlfvendedor
PROSPECCION_PRUEBA_APIKEY=
PROSPECCION_PRUEBA_APISECRET=
PROSPECCION_PRUEBA_APIKEY_2=
PROSPECCION_PRUEBA_APISECRET_2=
# 1 = también corre las pruebas de escritura (crean registros reales marcados TEST-MCP / [TEST MCP])
PRUEBAS_ESCRITURA=
